{
  "name": "codex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @codex/api db:generate",
    "db:migrate": "pnpm --filter @codex/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @codex/api db:migrate:deploy",
    "db:seed": "pnpm --filter @codex/api db:seed",
    "db:studio": "pnpm --filter @codex/api db:studio",
    "db:reset": "pnpm --filter @codex/api db:reset",
    "prepare": "husky",
    "test:e2e": "turbo run test:e2e"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@codex/config": "workspace:*",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  }
}
