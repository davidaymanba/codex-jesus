# ─── Local infrastructure (docker-compose.yml) ───────────────────────────────
# PostgreSQL superuser created on first container start. Use a non-default name.
POSTGRES_USER=codex_local
# PostgreSQL password. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-local-db-password
# Database created on first container start.
POSTGRES_DB=codex
# Host port PostgreSQL is exposed on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432
# Least-privilege role the API connects with (read/write rows only; created on first start).
APP_DB_USER=codex_app
# Password for APP_DB_USER. Generate one: openssl rand -hex 24
APP_DB_PASSWORD=change-me-local-app-db-password

# Redis password (enforced via --requirepass). Generate one: openssl rand -base64 24
REDIS_PASSWORD=change-me-local-redis-password
# Host port Redis is exposed on (bound to 127.0.0.1 only).
REDIS_PORT=6379
