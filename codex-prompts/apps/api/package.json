{
  "name": "@codex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@codex/emails": "workspace:*",
    "@codex/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@redis/client": "^6.3.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "resend": "^6.31.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@codex/config": "workspace:*",
    "@types/autocannon": "^7.12.7",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "5.0.2",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsdown": "0.23.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.2"
  }
}
