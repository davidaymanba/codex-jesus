# Runtime mode: development | test | production
NODE_ENV=development
# Port the API listens on.
PORT=4000
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public web origin. Used for the CORS allow-list and links in emails (Phase 2+).
FRONTEND_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Runtime connection, as the least-privilege app role (APP_DB_USER in the root .env).
# Production: the Neon *pooled* connection string (host contains "-pooler"), with ?sslmode=require.
DATABASE_URL=postgresql://codex_app:change-me-local-app-db-password@localhost:5432/codex
# Migrations / Prisma Studio connection, as the schema owner (POSTGRES_USER in the root .env).
# Production: the Neon *direct* (non-pooled) connection string.
DIRECT_URL=postgresql://codex_local:change-me-local-db-password@localhost:5432/codex

# ─── Redis ───────────────────────────────────────────────────────────────────
# Cache + rate-limit store. Local: the password is REDIS_PASSWORD in the root .env (URL-encoded).
# Production (required): the Upstash TCP endpoint, rediss://default:<token>@<host>:6379.
# Unset outside production: no cache, rate limits kept in memory.
REDIS_URL=redis://:change-me-local-redis-password@localhost:6379

# ─── HTTP ────────────────────────────────────────────────────────────────────
# Reverse proxies in front of the API; decides which X-Forwarded-For entry is the client IP.
# Local: 0. Railway: 1. Railway behind Cloudflare: 2. Too high lets clients spoof their IP.
TRUST_PROXY_HOPS=0
# Parent domain for auth cookies so web (codex.com) and API (api.codex.com) share them.
# Leave empty locally (host-only cookies on localhost). Production: codex.com
COOKIE_DOMAIN=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Ed25519 private key signing access tokens (EdDSA), as one base64 line. The web app will get
# the matching public key (Phase 6). Generate: openssl genpkey -algorithm ed25519 | base64 | tr -d '\n'
JWT_PRIVATE_KEY=
# Access token `iss` / `aud` claims.
JWT_ISSUER=codex-api
JWT_AUDIENCE=codex-admin
# HMAC key binding CSRF tokens to a session (32+ bytes). Generate: openssl rand -base64 32
CSRF_SECRET=change-me-generate-with-openssl-rand-base64-32
# HMAC key for ipHash columns; raw IPs are never stored (32+ bytes). Generate: openssl rand -base64 32
# Rotating it makes old hashes unmatchable (only matters for abuse investigation).
IP_HASH_SECRET=change-me-generate-with-openssl-rand-base64-32

# ─── API docs ────────────────────────────────────────────────────────────────
# Swagger UI at /api/docs is open outside production. In production it is disabled unless both
# are set, and then requires HTTP basic auth (password 16+ chars). Generate: openssl rand -base64 24
DOCS_USERNAME=
DOCS_PASSWORD=

# ─── Web integration ─────────────────────────────────────────────────────────
# Base URL of the admin UI for links in emails (lead notifications, password resets).
# Empty: FRONTEND_URL. The admin pages arrive in Phase 6.
ADMIN_URL=
# HMAC key signing the revalidation webhook to ${FRONTEND_URL}/api/revalidate (32+ bytes; the web
# app holds the same value). Empty outside production: no webhook is sent.
# Generate: openssl rand -base64 32
REVALIDATE_SECRET=
# Token the Next.js server sends as X-Codex-Internal on server-side fetches, so SSR/ISR traffic from
# a few Vercel egress IPs gets its own, higher rate limit (32+ bytes; never sent to browsers).
# Generate: openssl rand -base64 32
INTERNAL_API_TOKEN=

# ─── Forms and email ─────────────────────────────────────────────────────────
# Cloudflare Turnstile secret key. Empty outside production: the bot check is skipped.
# Cloudflare's test keys: 1x0000000000000000000000000000000AA (always passes),
# 2x0000000000000000000000000000000AA (always fails).
TURNSTILE_SECRET_KEY=
# Resend API key (re_…). Empty: emails are rendered and logged with a masked recipient, never sent.
RESEND_API_KEY=
# Sender of every email; its domain must be verified in Resend (SPF/DKIM/DMARC).
EMAIL_FROM=Codex <no-reply@codex.local>
# Company inbox notified of every quote request and contact message.
EMAIL_NOTIFY_TO=leads@codex.local

# ─── Media ───────────────────────────────────────────────────────────────────
# Cloudinary credentials, from the dashboard: cloudinary://<api key>:<api secret>@<cloud name>.
# Empty: uploads are refused (503). Seeded placeholder media never touches Cloudinary.
CLOUDINARY_URL=
# Folder per environment (e.g. codex/production, codex/staging). Empty: codex/<NODE_ENV>.
CLOUDINARY_FOLDER=

# ─── Dashboard ───────────────────────────────────────────────────────────────
# IANA time zone the dashboard groups "leads per month" by (e.g. Asia/Riyadh, Africa/Cairo).
REPORTING_TIME_ZONE=UTC

# ─── Seed only (pnpm db:seed) ────────────────────────────────────────────────
# First admin account. The seed refuses weak passwords (12+ chars, not guessable by common-password
# and pattern checks, must not contain the email name). Generate one: openssl rand -base64 18
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Display name for the admin account.
ADMIN_NAME=Codex Admin
