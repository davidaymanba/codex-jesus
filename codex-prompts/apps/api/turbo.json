{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/prisma/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test:integration": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DIRECT_URL",
        "REDIS_URL",
        "TEST_DATABASE_URL",
        "TEST_DIRECT_URL",
        "TEST_REDIS_URL"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DIRECT_URL",
        "REDIS_URL",
        "TEST_DATABASE_URL",
        "TEST_DIRECT_URL",
        "TEST_REDIS_URL"
      ],
      "outputs": ["coverage/**"]
    }
  }
}
