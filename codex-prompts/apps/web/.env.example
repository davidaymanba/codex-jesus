# ─── Server-only (never sent to the browser) ─────────────────────────────────
# Base URL the Next.js server uses to call the API (can be an internal address).
API_URL=http://localhost:4000

# Shared secrets: the SAME values as INTERNAL_API_TOKEN / REVALIDATE_SECRET in apps/api/.env.
# Optional in development, required in production (openssl rand -base64 32).
INTERNAL_API_TOKEN=
REVALIDATE_SECRET=

# Serve the /[locale]/dev/ui component showcase on a production build (local audits only).
ENABLE_UI_SHOWCASE=false

# ─── Public (inlined into the client bundle at build time) ───────────────────
# Base URL the browser uses to call the API (admin dashboard, forms).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Canonical public URL of this site (used for canonical links, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key (public forms). The value below is Cloudflare's test key that
# always passes; production needs the real key, with TURNSTILE_SECRET_KEY set on the API.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
